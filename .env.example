# Set locally. Do not commit .env or paste credentials into chat.
DATABASE_URL=
PREVIEW_WORKER_TOKEN=
# Optional overrides; defaults are documented in README.md.
HOST=
PORT=
PREVIEW_WORKER_URL=
PREVIEW_PUBLIC_URL=
PREVIEW_HOST=
PREVIEW_PORT=
# Docker Compose database provisioning only:
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Control plane + separate AI build worker; use a token distinct from preview token:
BUILD_WORKER_TOKEN=
# Set the following ONLY in the separate build worker process environment.
# Do not copy OPENAI_API_KEY into the control-plane .env file.
